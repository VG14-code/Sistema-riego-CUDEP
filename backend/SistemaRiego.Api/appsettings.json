{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=SistemaRiego;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "SistemaRiego.Api",
    "Audience": "SistemaRiego.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "PasswordRecoveryMinutes": 30
  },
  "Email": {
    "FromAddress": "vgbm123456@gmail.com",
    "FromName": "Sistema de Riego CUDEP",
    "FrontendBaseUrl": "http://localhost:5173",
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": 587,
    "SmtpUsername": "vgbm123456@gmail.com",
    "EnableSsl": true
  },
  "SeedAdmin": {
    "Email": "admin@sistemariego.local",
    "FullName": "Administrador del sistema"
  },
  "AllowedOrigins": [
    "http://localhost:5173"
  ],
  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "ClientId": "sistema-riego-api",
    "TelemetryTopic": "granja/+/sensor/+/lectura",
    "CommandTopicTemplate": "granja/{zone}/valvula/{device}/comando",
    "ReconnectSeconds": 5
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sistema-riego-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
